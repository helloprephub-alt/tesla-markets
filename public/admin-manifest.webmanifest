{
  "id": "/admin.html?app=tesla-markets-admin",
  "name": "Tesla Markets Management",
  "short_name": "Tesla Admin",
  "description": "Private Tesla Markets management console and customer inbox.",
  "start_url": "/admin.html?page=admin&app=tesla-markets-admin",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e82127",
  "theme_color": "#e82127",
  "icons": [
    {
      "src": "/icons/tesla-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/tesla-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait"
}
