{
  "name": "Tesla Markets",
  "short_name": "Tesla Markets",
  "description": "Independent vehicle and market information, vehicle enquiries, and customer support.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e82127",
  "theme_color": "#e82127",
  "icons": [
    {
      "src": "/icons/tesla-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/tesla-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait"
}
